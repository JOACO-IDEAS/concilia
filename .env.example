# Copiar a .env y completar con una base de datos real para usar Prisma.
# Este proyecto no tiene una base de datos provisionada todavía — el resto de
# la app (dashboard, conciliación, morosidad, etc.) sigue funcionando 100%
# con datos mock en memoria, sin depender de esta variable.

# Connection string "pooled" (a través de PgBouncer) — la usa la app en
# runtime (src/lib/prisma.ts) para las queries normales. Con Neon: la URL que
# termina en "...neon.tech/..." con "-pooler" en el host.
DATABASE_URL="postgresql://user:password@localhost:5432/concilia?schema=public"

# Connection string "direct" (sin pooler) — la usa el motor de migraciones de
# Prisma (`prisma migrate deploy`), que necesita una conexión de sesión
# completa para los advisory locks. Con Neon: la misma URL que DATABASE_URL
# pero sin "-pooler" en el host. Si tu proveedor no separa pooled/direct,
# usar el mismo valor en las dos variables.
DIRECT_URL="postgresql://user:password@localhost:5432/concilia?schema=public"

# Secreto compartido para verificar webhooks entrantes de proveedores de pago
# (POST /api/v1/webhooks/payments). Sin esta variable, el endpoint rechaza
# TODOS los webhooks (fail closed) — nunca procesa nada sin poder verificarlo.
# Generar uno fuerte, ej: openssl rand -hex 32
PAYMENTS_WEBHOOK_SECRET="reemplazar-por-un-secreto-largo-y-aleatorio"

# Opcional: protege el detalle del healthcheck (GET /api/health?key=...).
# Sin esta variable, el endpoint responde igual (para que sirva de latido
# simple para monitoreo) pero solo con el status, sin detalle de tablas/latencia.
HEALTH_CHECK_SECRET="reemplazar-por-otro-secreto-largo-y-aleatorio"

# Opcional: API key de Resend (https://resend.com) para las notificaciones
# automáticas por email que dispara el webhook de pagos (recibo al conciliar
# + alerta al Administrator cuando un pago queda sin vincular). Sin esta
# variable, el webhook sigue funcionando normal — solo loguea un aviso y no
# envía el mail (ver src/lib/notifications/resend-client.ts).
RESEND_API_KEY=""

# Opcional: remitente de las notificaciones, formato "Nombre <email@dominio>".
# Sin esta variable usa "ConcilIA <onboarding@resend.dev>", la dirección de
# prueba que Resend habilita sin verificar un dominio propio — para producción
# real hace falta verificar un dominio en Resend y apuntar acá a esa casilla.
NOTIFICATIONS_FROM_EMAIL=""

# Opcional: URL pública de la app, usada para armar el link "Vincular en el
# panel" del email de alerta de pago sin reconciliar. Sin esta variable usa
# la URL de producción por defecto (https://conciliia-app.vercel.app).
NEXT_PUBLIC_APP_URL=""

# Opcional: credenciales de WhatsApp Cloud API (Meta) para el recibo de pago,
# la alerta de pago sin vincular y el recordatorio de morosidad por WhatsApp
# (ver src/lib/whatsapp/). Sin estas dos variables, cada envío queda en modo
# simulación: loguea a quién y qué le hubiera mandado, y no rompe nada — el
# mismo comportamiento que RESEND_API_KEY sin configurar.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Opcional: versión de la Graph API de Meta. Por defecto "v21.0".
WHATSAPP_API_VERSION=""

# Opcional: teléfono(s) en formato E.164 (separados por coma si son varios)
# que reciben la alerta de "pago sin vincular" por WhatsApp. Administrator no
# tiene un campo de teléfono en el schema (solo email) — ver decisión de
# diseño en PROGRESS.md — así que este número se configura acá en vez de en
# la base. Sin esta variable, esa alerta puntual por WhatsApp no tiene
# destinatario y se omite (el resto del pipeline sigue funcionando).
WHATSAPP_ADMIN_PHONE=""

# Opcional: API key de OpenAI para el parser universal de extractos con IA
# (PDF/imagen/CSV de cualquier banco o billetera de LATAM — ver
# src/lib/statements/ai-parser.ts). Sin esta variable, la ingesta de
# extractos degrada al parser heurístico local: sigue funcionando para PDF y
# CSV con texto real (peor que la IA para formatos poco comunes), pero las
# imágenes (PNG/JPG) no tienen fallback posible y quedan rechazadas con un
# mensaje claro.
OPENAI_API_KEY=""

# Opcional: modelo de OpenAI a usar (debe soportar Vision + Structured
# Outputs). Por defecto "gpt-4o-mini".
OPENAI_MODEL=""
