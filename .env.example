# ConcilIA environment contract — names and safe placeholders only.
# Copy to `.env` for disposable local development. Never copy values from
# `.env.local`, `.env.fixtures.local`, Vercel, Neon, or another operator.

# LOCAL REQUIRED
# None for install, lint, typecheck, the offline test suite, Prisma
# generate/validate, or a localhost-only production build.

# LOCAL OPTIONAL — SERVER ONLY
# Use a disposable local Postgres database. Prisma runtime reads DATABASE_URL;
# migration commands prefer DIRECT_URL, then DATABASE_URL_UNPOOLED, then
# DATABASE_URL. Never put a production or fixtures URL in a normal local file.
DATABASE_URL="postgresql://concilia:concilia@127.0.0.1:5432/concilia_dev?schema=public"
DIRECT_URL="postgresql://concilia:concilia@127.0.0.1:5432/concilia_dev?schema=public"
DATABASE_URL_UNPOOLED=""

# Explicit target required by Prisma Safety for risky database commands.
# Valid values are `fixtures` or `production`; leave blank for normal work.
PRISMA_TARGET_ENV=""

# Local/pilot authentication. Real values belong only in server-side secret
# stores. Bootstrap credentials must identify an existing Administrator.
CONCILIA_SESSION_SECRET=""
CONCILIA_BOOTSTRAP_ADMIN_EMAIL=""
CONCILIA_BOOTSTRAP_ADMIN_PASSWORD=""

# Incoming payment webhook and detailed health-check protection.
# The payment webhook fails closed when its secret is absent.
PAYMENTS_WEBHOOK_SECRET=""
HEALTH_CHECK_SECRET=""

# Optional outbound providers. Missing credentials keep outbound delivery
# disabled/simulated; authorization is still required before any real send.
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_API_VERSION=""
WHATSAPP_ADMIN_PHONE=""

# Optional server-side AI configuration. Never rename these with a
# NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_AGENT_MODEL=""

# Server-only exact origin used for pilot magic links. HTTPS is required
# outside localhost; no path, query, fragment, or embedded credentials.
CONCILIA_APP_ORIGIN="http://localhost:3000"

# BROWSER-SAFE
# Used only to build public links in notifications. It contains no credential.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# FIXTURES SERVER-ONLY
# Fixtures credentials live in ignored `.env.fixtures.local`, never here.
# The fixture suites are excluded from `npm test` and require explicit opt-in.
EPIC2_P2028_RUNS=""
EPIC2_P2028_CANDIDATES=""
EPIC2_P2028_REPORT=""

# PRODUCTION SERVER-ONLY
# Production uses the same server-only names above, populated through Vercel/
# Neon/provider secret stores. No production value belongs in this repository.
# `VERCEL` and `NODE_ENV` are platform-managed and should not be set manually.
