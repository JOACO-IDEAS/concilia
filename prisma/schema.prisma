// ============================================================================
// ConcilIA — Módulo de Administración, Contactos y Facturación
// ============================================================================
//
// Mapa de entidades y relaciones:
//
//   Administrator  ──M:N──  Organization  ──M:N──  Contact
//        (via OrganizationAdministrator)   (via ContactOrganization)
//                              │
//                              ├──1:N── ContactChannel   (mails/teléfonos de cobranza y notificaciones)
//                              └──1:N── BillingProfile   (datos fiscales y bancarios)
//
// - Un Administrator (ej. "Estudio Fernández Administraciones") gestiona una o
//   varias Organization (consorcios/edificios/empresas — el "cliente" del SaaS).
// - Un Contact (persona física) puede estar vinculado a varias Organization a
//   la vez (ej. un contador que atiende varios consorcios). La marca de
//   "contacto primario" vive en la tabla intermedia ContactOrganization, no en
//   Contact, porque una misma persona puede ser el contacto principal de un
//   consorcio y secundario en otro — es una propiedad de la relación, no de
//   la persona.
// - ContactChannel modela cualquier canal de comunicación (email/teléfono/
//   WhatsApp) usado para cobranzas o notificaciones. Puede pertenecer a un
//   Contact puntual o ser un canal genérico de la Organization (ej. una
//   casilla compartida "facturacion@consorcio.com" que no es de una persona).
// - BillingProfile guarda los datos fiscales/bancarios. Es 1:N (no 1:1) para
//   soportar organizaciones con más de una cuenta/moneda; `isDefault` marca
//   cuál se usa por defecto.
// - PaymentTransaction (Fase 3): eventos de cobro recibidos por webhook desde
//   proveedores de Open Banking (Belvo/Prometeo/Pluggy/pasarelas). Cada uno
//   apunta opcionalmente a una Organization (N:1) — null mientras esté
//   UNMATCHED, esperando vínculo manual.
//
// Generado con Prisma 7 (generator "prisma-client" + driver adapter para
// PostgreSQL). Ver src/lib/prisma.ts para la instancia del cliente.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // La URL de conexión NO vive acá en Prisma 7 — se configura en
  // prisma.config.ts (leída desde la env var DATABASE_URL).
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContactChannelType {
  EMAIL
  PHONE
  WHATSAPP
}

enum ContactChannelPurpose {
  BILLING // usado para el envío de facturas / cadena de cobranza
  NOTIFICATIONS // avisos operativos (vencimientos, alertas, etc.)
  GENERAL
}

enum BankAccountType {
  CBU
  IBAN
  ALIAS
  OTHER
}

enum PaymentTransactionStatus {
  PENDING // recibido, todavía no pasó por el motor de reconciliación
  MATCHED // se encontró una Organization dueña del pago
  UNMATCHED // no se encontró ninguna coincidencia — requiere vínculo manual
}

// Cómo se llegó a MATCHED — usado por el dashboard de analítica para calcular
// la "tasa de reconciliación automática" (AUTO = lo resolvió el motor de
// reconcile-payment.ts al recibir el webhook; MANUAL = lo vinculó a mano un
// administrador desde la pestaña Webhooks de /conciliacion). Null mientras el
// pago no esté MATCHED.
enum PaymentMatchMethod {
  AUTO
  MANUAL
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
}

// ----------------------------------------------------------------------------
// Enums del Motor de Conciliación por Unidad (Fase 1 — ver
// RECONCILIATION_ENGINE_IMPLEMENTATION.md). Solo modelo de datos en esta
// fase: sin motor de matching, sin score, sin IA, sin auto-conciliación.
// ----------------------------------------------------------------------------

enum UnitOccupantType {
  OWNER
  TENANT
}

enum ObligationStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

// Qué tipo de evento representa una fila de ReconciliationMatch — ver ese
// modelo más abajo para el porqué de "append-only".
enum ReconciliationDecision {
  AUTO
  SUGGESTED
  APPROVED
  REJECTED
  EXCEPTION
}

// Estado de un PaymentNotice (Fase 3.2 — ver FASE_3_1_PREPARACION_DE_DATOS.md
// §7). Puramente informativo del ciclo de vida del aviso — nunca implica que
// el dinero haya ingresado al banco; eso lo sigue confirmando únicamente
// PaymentTransaction.
enum PaymentNoticeStatus {
  RECEIVED // recién llegó, sin procesar todavía
  EXTRACTED // se corrió extracción sobre el adjunto/texto del mensaje
  MATCHED_PENDING // se generaron candidatos (Unit/UnitOwner/PaymentTransaction), esperando decisión
  LINKED // vinculado a un PaymentTransaction real — el dinero SÍ se confirmó
  DISCARDED // no correspondía a nada real, duplicado, o nunca se confirmó y se cerró
}

// Estado de un resultado de matching en MODO SOMBRA (Fase 3.3/3.4/3.5 — ver
// src/lib/reconciliation/types.ts::CandidateStatus, el mismo tipo a nivel de
// código). Deliberadamente NO incluye "AUTO": el motor sombra nunca produce
// ni puede producir ese valor — ver deterministic-matcher.ts/confidence-engine.ts.
enum ShadowMatchStatus {
  CANDIDATE
  AMBIGUOUS
  BLOCKED
}

// Fase 5.9 — estados de src/lib/reconciliation/../payment-evidence/evidence-score.ts
// (Fase 5.7, sin cambios de lógica). Deliberadamente distinto de
// ShadowMatchStatus: responde una pregunta distinta (convergencia de
// FAMILIAS de evidencia, no solo el resultado del motor bancario) — ver
// FASE_5_7_PAYMENT_EVIDENCE_SCORE_DESIGN.md Parte 6. Nunca incluye "AUTO":
// RECONCILIATION_CONFIRMED es una clasificación calculada en memoria, jamás
// una escritura ni una acción — ver FASE_5_7_INFORME_IMPLEMENTACION.md §11.
enum PaymentEvidenceState {
  INFORMATIONAL
  NEEDS_DATA
  NEEDS_DECISION
  PRE_CONCILIABLE
  RECONCILIATION_CONFIRMED
}

enum PaymentEvidenceCorrelationStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

enum PaymentEvidenceCorrelationSource {
  SYSTEM_EVIDENCE
  HUMAN_REVIEW
}

enum PaymentEvidenceIntakeSource {
  WEB_UPLOAD
  WHATSAPP
  EMAIL
  API
  OTHER
}

enum PaymentEvidenceIntakeType {
  IMAGE
  PDF
  TEXT
  STRUCTURED_DATA
}

// Intake is an immutable receipt fact. Extraction/processing state belongs to
// a future, separate projection rather than rewriting the original evidence.
enum PaymentEvidenceIntakeState {
  RECEIVED
}

enum PaymentEvidenceExtractionSource {
  STRUCTURED
  TEXT
  EXTERNAL_EXTRACTOR
}

enum PaymentEvidenceExtractionStatus {
  SUCCEEDED
  FAILED
  UNSUPPORTED
}

enum PaymentEvidenceFactType {
  AMOUNT
  DATE
  OPERATION_REFERENCE
  BANK_NAME
  PAYER_DISPLAY_NAME
  ACCOUNT_IDENTIFIER
  TRANSFER_REFERENCE
}

enum PaymentEvidenceDateRole {
  OPERATION
  ISSUED
  ACCREDITATION
  UNKNOWN
}

enum PaymentEvidenceAccountType {
  CBU
  CVU
  ALIAS
  ACCOUNT
  OTHER
}

enum WhatsAppProvider {
  META_CLOUD
}

enum WhatsAppChannelConnectionStatus {
  ACTIVE
  INACTIVE
}

enum AgentConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

enum PayerStatus {
  ACTIVE
  REVOKED
}

enum PayerProvenanceSource {
  HUMAN_REVIEW
  IMPORT
  SYSTEM_OBSERVATION
}

enum PayerIdentitySignalType {
  PHONE
  WHATSAPP
  BANK_ACCOUNT
  BANK_ALIAS
  BANK_PAYER_NAME
  TAX_ID
  EMAIL
  TRANSFER_IDENTIFIER
  OTHER
}

enum PayerUnitAssociationStatus {
  OBSERVED
  DISPUTED
  REVOKED
}

enum PayerUnitEvidenceEffect {
  SUPPORT
  CONTRADICT
  REVOKE
}

enum PayerUnitEvidenceSource {
  PAYMENT_CONFIRMED
  HUMAN_CONFIRMATION
  SYSTEM_OBSERVATION
}

// Eventos opacos y append-only de protección de acceso piloto. No contienen
// email, IP, token ni hashes reutilizables: subjectKey es un HMAC con dominio.
enum PilotAccessRateLimitScope {
  ISSUE_EMAIL
  ISSUE_IP
  CONSUME_TOKEN
  CONSUME_IP
}

// ----------------------------------------------------------------------------
// Administrator — el actor que gestiona una o varias Organization.
// ----------------------------------------------------------------------------
model Administrator {
  id    String @id @default(cuid())
  name  String
  email String @unique

  organizations                     OrganizationAdministrator[]
  pilotAccessTokens                 PilotAccessToken[]
  paymentEvidenceCorrelations       PaymentEvidenceCorrelation[]
  payersCreated                     Payer[]
  payerIdentitySignalsCreated       PayerIdentitySignal[]
  payerUnitEvidenceEventsCreated    PayerUnitEvidenceEvent[]
  paymentEvidenceIntakesReceived    PaymentEvidenceIntake[]
  paymentEvidenceExtractionRuns     PaymentEvidenceExtractionRun[]
  whatsAppChannelConnectionsCreated WhatsAppChannelConnection[]
  agentConversations                AgentConversation[]
  administrativeDocumentsCreated    AdministrativeDocument[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — null = activo

  @@index([email])
  @@map("administrators")
}

model PilotAccessToken {
  id              String        @id @default(cuid())
  administratorId String
  tokenHash       String        @unique
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())
  administrator   Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)

  @@index([administratorId])
  @@index([expiresAt])
  @@map("pilot_access_tokens")
}

model PilotAccessRateLimitEvent {
  id         String                    @id @default(cuid())
  scope      PilotAccessRateLimitScope
  subjectKey String
  createdAt  DateTime                  @default(now())

  @@index([scope, subjectKey, createdAt])
  @@index([createdAt])
  @@map("pilot_access_rate_limit_events")
}

// Tabla intermedia N:M entre Administrator y Organization.
// Un administrador puede gestionar varias organizaciones y (a futuro) una
// organización podría tener más de un administrador asignado (ej. un equipo).
model OrganizationAdministrator {
  id              String   @id @default(cuid())
  administratorId String
  organizationId  String
  createdAt       DateTime @default(now())

  administrator Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Un mismo administrador no puede estar vinculado dos veces a la misma organización.
  @@unique([administratorId, organizationId])
  @@index([organizationId])
  @@map("organization_administrators")
}

// ----------------------------------------------------------------------------
// Organization — el "cliente" del SaaS (consorcio / edificio / empresa).
// ----------------------------------------------------------------------------
model Organization {
  id String @id @default(cuid())

  name      String // nombre comercial / display (ej. "Consorcio Av. Cabildo 2450")
  legalName String // razón social
  taxId     String // CUIT / RUT / RFC según el país

  address String
  status  OrganizationStatus @default(ACTIVE)

  administrators                OrganizationAdministrator[]
  contacts                      ContactOrganization[]
  channels                      ContactChannel[]
  billingProfiles               BillingProfile[]
  paymentTransactions           PaymentTransaction[]
  paymentReminders              PaymentReminder[]
  units                         Unit[]
  paymentNotices                PaymentNotice[]
  paymentEvidenceCorrelations   PaymentEvidenceCorrelation[]
  paymentEvidenceIntakes        PaymentEvidenceIntake[]
  paymentEvidenceExtractionRuns PaymentEvidenceExtractionRun[]
  paymentEvidenceFacts          PaymentEvidenceFact[]
  whatsAppChannelConnections    WhatsAppChannelConnection[]
  agentConversations            AgentConversation[]
  agentMessages                 AgentMessage[]
  payers                        Payer[]
  payerIdentitySignals          PayerIdentitySignal[]
  payerUnitAssociations         PayerUnitAssociation[]
  payerUnitEvidenceEvents       PayerUnitEvidenceEvent[]
  // Fase 4 Parte C — Compliance Foundation. Relaciones inversas obligatorias
  // de Prisma (sintaxis, no crean ninguna columna real en esta tabla) — ver
  // ProviderOrganization/ProviderDocument más abajo.
  providerOrganizations         ProviderOrganization[]
  providerDocuments             ProviderDocument[]
  administrativeDocuments       AdministrativeDocument[]
  agentObservations             AgentObservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — null = activa

  // Evita duplicar el mismo tax_id como dos organizaciones distintas.
  // Nota: hoy es única a nivel global porque este SaaS opera con un único
  // tenant (un Administrator central). Si en el futuro se soporta multi-tenant
  // real (varios estudios administradores no relacionados compartiendo la
  // misma base), reemplazar por un unique compuesto (tenantId, taxId).
  @@unique([taxId])
  @@index([status])
  @@map("organizations")
}

// ----------------------------------------------------------------------------
// Contact — persona física vinculada a una o varias Organization.
// ----------------------------------------------------------------------------
model Contact {
  id String @id @default(cuid())

  firstName String
  lastName  String
  jobTitle  String? // cargo / rol (ej. "Contador", "Presidente del consorcio")

  organizations ContactOrganization[]
  channels      ContactChannel[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — null = activo

  @@index([lastName, firstName])
  @@map("contacts")
}

// Tabla intermedia N:M entre Contact y Organization.
// `isPrimaryContact` vive acá (no en Contact) porque es una propiedad de la
// relación: la misma persona puede ser contacto principal de un consorcio y
// secundario en otro.
model ContactOrganization {
  id               String   @id @default(cuid())
  contactId        String
  organizationId   String
  isPrimaryContact Boolean  @default(false)
  createdAt        DateTime @default(now())

  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Un mismo contacto no puede vincularse dos veces a la misma organización.
  @@unique([contactId, organizationId])
  @@index([organizationId])
  @@map("contact_organizations")
}

// ----------------------------------------------------------------------------
// ContactChannel — cadena de comunicación (email/teléfono/WhatsApp) para
// cobranzas o notificaciones. Siempre pertenece a una Organization; puede
// además estar asociado a un Contact puntual, o ser un canal genérico de la
// organización (ej. una casilla compartida de facturación).
// ----------------------------------------------------------------------------
model ContactChannel {
  id String @id @default(cuid())

  organizationId String
  contactId      String? // opcional: null = canal genérico de la organización

  type       ContactChannelType
  value      String // el email / número de teléfono en sí
  purpose    ContactChannelPurpose @default(GENERAL)
  isVerified Boolean               @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — null = activo

  // Evita cargar el mismo canal duplicado para la misma organización.
  @@unique([organizationId, type, value])
  @@index([organizationId])
  @@index([contactId])
  @@index([value])
  @@index([organizationId, purpose])
  @@map("contact_channels")
}

// ----------------------------------------------------------------------------
// BillingProfile — datos fiscales y bancarios de una Organization.
// Es 1:N (no 1:1): la mayoría de las organizaciones tendrán un solo perfil,
// pero el modelo soporta más de una cuenta/moneda por organización.
// `isDefault` marca cuál se usa por defecto al facturar.
// ----------------------------------------------------------------------------
model BillingProfile {
  id             String @id @default(cuid())
  organizationId String

  taxCondition      String // ej. "Responsable Inscripto", "Monotributo" (texto libre: varía por país)
  bankAccountType   BankAccountType
  bankAccountNumber String // CBU / IBAN / Alias, según bankAccountType
  billingCurrency   String          @default("ARS") // código ISO 4217 (ARS, USD, ...)
  paymentTerms      String // ej. "30 días", "Contado"
  isDefault         Boolean         @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — null = activo

  @@index([organizationId])
  @@map("billing_profiles")
}

// ----------------------------------------------------------------------------
// PaymentTransaction — un evento de cobro recibido por webhook desde un
// proveedor de Open Banking / pasarela de pagos (Belvo, Prometeo, Pluggy,
// etc. — ver src/app/api/v1/webhooks/payments/route.ts).
//
// El motor de reconciliación (src/lib/payments/reconcile-payment.ts) intenta
// vincular cada pago a una Organization por CUIT (`Organization.taxId`) o por
// CBU/Alias (`BillingProfile.bankAccountNumber`) usando `payerIdentifier`.
// Si no encuentra nada, queda en UNMATCHED para vincular a mano desde la
// pestaña "Webhooks" de /conciliacion.
// ----------------------------------------------------------------------------
model PaymentTransaction {
  id String @id @default(cuid())

  // Id que asigna el proveedor externo a la transacción — es la clave de
  // idempotencia: un mismo `externalId` nunca genera dos registros, aunque el
  // proveedor reintente el webhook (algo común y esperado en estas APIs).
  externalId String @unique

  provider String // ej. "belvo" | "prometeo" | "pluggy" | "generic" — texto libre, no enum, porque la lista de proveedores crece

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Unidad Funcional resuelta por el Motor de Conciliación (Fase 1 — ver
  // RECONCILIATION_ENGINE_IMPLEMENTATION.md). Nullable a propósito: durante
  // la importación inicial de un extracto, o mientras no exista el motor de
  // matching (fases siguientes), no hay ninguna unidad resuelta todavía —
  // el pago sigue siendo válido y consultable solo por `organizationId`,
  // exactamente como funciona hoy. `status`/`matchedAt`/`matchMethod` NO
  // cambian de significado: MATCHED sigue siendo "sabemos a quién
  // pertenece"; que además se haya resuelto a nivel unidad es información
  // adicional, no un reemplazo.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("ARS") // código ISO 4217

  // CUIT/RUT o CBU/Alias tal como vino en el payload — es lo que usa el
  // motor de reconciliación para buscar la Organization, y lo que se le
  // muestra al administrador para vincular a mano si quedó UNMATCHED.
  payerIdentifier String?
  concept         String? // referencia / concepto del pago, si el proveedor lo manda

  // Fase 3.2 — preservan datos que el pipeline de extracción (IA o webhook)
  // ya obtiene pero que antes se descartaban antes de persistir (ver
  // FASE_3_1_PREPARACION_DE_DATOS.md §1). Ninguna reemplaza a `createdAt`:
  // `createdAt` sigue significando "cuándo ConcilIA creó el registro";
  // `transactionDate` es cuándo ocurrió el movimiento bancario real.
  transactionDate DateTime? // fecha real del movimiento, si se pudo extraer
  referenceNumber String? // número de comprobante/transacción, si el banco/proveedor lo informa

  status      PaymentTransactionStatus @default(PENDING)
  matchedAt   DateTime? // se completa cuando status pasa a MATCHED (automático o manual)
  matchMethod PaymentMatchMethod? // AUTO (motor de reconciliación) o MANUAL (vínculo a mano) — null mientras no esté MATCHED

  rawPayload Json // payload crudo tal como llegó — para auditoría y debugging

  reconciliationMatches         ReconciliationMatch[]
  paymentNotices                PaymentNotice[]
  shadowMatchLogs               ShadowMatchLog[]
  paymentEvidenceAssessmentLogs PaymentEvidenceAssessmentLog[]
  paymentEvidenceCorrelations   PaymentEvidenceCorrelation[]
  // Fase 4.F — relación inversa obligatoria de Prisma (sintaxis, cero
  // columna real nueva acá). Ver AgentObservation.paymentTransactionId más
  // abajo — la columna real vive en AgentObservation, no acá.
  agentObservations             AgentObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([unitId])
  @@index([status])
  @@index([payerIdentifier])
  @@map("payment_transactions")
}

// ----------------------------------------------------------------------------
// PaymentReminder — Módulo de Morosidad: historial de recordatorios de
// cobranza enviados a una Organization. No hay un modelo de expensas/deuda
// emitida en este schema todavía (ver src/lib/delinquency/detect-overdue.ts
// para la heurística de "en mora" que se calcula a partir de esto) — este
// modelo existe puramente como guarda anti-spam: no se manda un nuevo
// recordatorio si ya se envió uno dentro de la ventana de cooldown
// (REMINDER_COOLDOWN_DAYS), y como auditoría de qué se le dijo a cada
// organización y cuándo.
// ----------------------------------------------------------------------------
model PaymentReminder {
  id             String @id @default(cuid())
  organizationId String

  channel     ReminderChannel
  amountDue   Decimal         @db.Decimal(14, 2) // monto estimado al momento del envío — auditoría, no se recalcula retroactivamente
  daysOverdue Int

  sentAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sentAt])
  @@map("payment_reminders")
}

// ----------------------------------------------------------------------------
// Motor de Conciliación por Unidad — Fase 1 (ver
// RECONCILIATION_ENGINE_IMPLEMENTATION.md). Solo el modelo de datos: sin
// motor de matching, sin score, sin IA, sin auto-conciliación, sin UI nueva.
// Esas fases se construyen encima de esto, sin tocar nada de lo que ya
// funciona hoy (ingesta de extractos, reconciliación por Organization).
// ----------------------------------------------------------------------------

// Unit — Unidad Funcional real, ligada a una Organization (consorcio). Hoy
// solo existe como mock (UnidadFuncional en src/lib/mock-data.ts) — este
// modelo la hace real.
model Unit {
  id             String @id @default(cuid())
  organizationId String

  code        String // ej. "3A" — identificador humano de la unidad
  coefficient Decimal? @db.Decimal(6, 4) // % de participación — opcional, no bloquea el matching, se completa después

  organization                  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owners                        UnitOwner[]
  obligations                   Obligation[]
  matches                       ReconciliationMatch[]
  paymentTransactions           PaymentTransaction[]
  paymentNotices                PaymentNotice[]
  shadowMatchLogs               ShadowMatchLog[]
  paymentEvidenceAssessmentLogs PaymentEvidenceAssessmentLog[]
  payerUnitAssociations         PayerUnitAssociation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — null = activa

  // No puede haber dos "UF 3A" en el mismo consorcio.
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("units")
}

// UnitOwner — titular (propietario o inquilino) de una Unit. NO reutiliza
// Contact a propósito: Contact modela a alguien que gestiona la relación
// comercial con la Organization (contador, presidente) — un dominio y un
// ciclo de vida distintos del de "quién vive/paga esta unidad" (ver
// RECONCILIATION_ENGINE_IMPLEMENTATION.md sección A). No se creó una entidad
// Person separada: para esta fase no hace falta reutilizar identidad de
// persona entre unidades — un mismo titular con varias unidades simplemente
// tiene varias filas de UnitOwner, denormalizado a propósito.
model UnitOwner {
  id     String @id @default(cuid())
  unitId String

  fullName     String
  taxId        String? // CUIT/CUIL — sin esto el matching (fase futura) pierde su señal más fuerte, pero no es obligatorio cargarlo
  relationship UnitOccupantType @default(OWNER)
  email        String?
  phone        String?
  isPrimary    Boolean          @default(true) // co-titularidad — mismo criterio que ContactOrganization.isPrimaryContact

  unit            Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  paymentNotices  PaymentNotice[]
  shadowMatchLogs ShadowMatchLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — null = activo

  // Evita duplicar la misma persona en la misma unidad. Sin unique global
  // sobre taxId: la misma persona puede ser titular de varias unidades.
  @@unique([unitId, taxId])
  @@index([unitId])
  @@index([taxId])
  // Fase 3.2 — soporta la resolución de identidad por teléfono/WhatsApp
  // (ver FASE_3_1_PREPARACION_DE_DATOS.md §6.4): sin este índice, buscar
  // "a quién pertenece este número" escanearía toda la tabla.
  @@index([phone])
  @@map("unit_owners")
}

// Obligation — deuda/factura/expensa de una Unit para un período. No existe
// hoy ninguna base real de esto (ver IMPORT_PIPELINE.md, hallazgo sobre el
// archivo de "liquidación de expensas" sin dónde importarse) — este modelo
// la crea. La carga de datos real (importación, alta manual) es Fase 3, no
// esta fase.
model Obligation {
  id     String @id @default(cuid())
  unitId String

  period      DateTime // primer día del mes que corresponde, ej. 2026-08-01
  amount      Decimal          @db.Decimal(14, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(14, 2) // se actualiza junto con cada match aprobado (fase futura) — 0 mientras no exista el motor
  status      ObligationStatus @default(PENDING)
  concept     String? // ej. "Expensas Agosto 2026"
  dueDate     DateTime?
  externalRef String? // referencia/identificador del sistema de origen, si existe (ej. nro de liquidación)

  unit            Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  matches         ReconciliationMatch[]
  shadowMatchLogs ShadowMatchLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — null = vigente

  // No se pueden emitir dos expensas del mismo período para la misma unidad
  // — si hay que corregir un importe, se edita el registro, no se duplica.
  @@unique([unitId, period])
  @@index([unitId, status])
  @@map("obligations")
}

// ReconciliationMatch — historial de conciliación a nivel Unidad. APPEND-ONLY
// a propósito: cada fila es UN EVENTO de decisión (sugerencia del motor,
// aprobación, rechazo, excepción) — nunca se actualiza una fila existente,
// mismo criterio que PaymentReminder (arriba). Es la única forma de que la
// auditoría (quién decidió, cuándo, con qué evidencia, qué candidatos
// alternativos se consideraron) sea real y no una versión mutable que pierde
// historia. El "candidato finalmente elegido" para un pago se lee del último
// evento con decision AUTO o APPROVED en su cadena — el historial completo,
// incluidos los rechazos, nunca se borra ni se sobreescribe.
//
// `score` queda nullable (0-99, o null cuando no hubo scoring — ej. un
// vínculo manual sin motor de por medio). `signals`/`reason` son obligatorios
// en cualquier fila — incluso una decisión manual debe dejar un motivo
// legible y un detalle estructurado, aunque sea mínimo (`{}` / "Vinculado
// manualmente"). El motor que los calcula automáticamente es de una fase
// futura; el modelo ya soporta guardarlos desde ahora.
//
// `decidedBy` queda nullable a propósito: no existe todavía autenticación
// real de usuarios en el proyecto (riesgo documentado explícitamente en
// RECONCILIATION_ENGINE_IMPLEMENTATION.md sección J). null = decisión del
// sistema (AUTO); se completa con una identidad real cuando exista login.
model ReconciliationMatch {
  id                   String @id @default(cuid())
  paymentTransactionId String

  unitId       String?
  obligationId String?

  decision ReconciliationDecision
  score    Int? // 0-99 — null en una EXCEPCIÓN pura o un vínculo manual sin scoring
  signals  Json // detalle estructurado de qué señales aportaron + candidatos alternativos considerados
  reason   String // motivo legible, ej. "CUIT coincide + UF coincide + importe coincide"

  decidedBy       String? // null = sistema/automático — ver nota arriba sobre autenticación
  rejectionReason String? // solo cuando decision = REJECTED

  paymentTransaction      PaymentTransaction       @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  unit                    Unit?                    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  obligation              Obligation?              @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  payerUnitEvidenceEvents PayerUnitEvidenceEvent[]

  createdAt DateTime @default(now()) // fecha/hora del evento — no hay updatedAt, la fila no se edita

  @@index([paymentTransactionId, createdAt])
  @@index([unitId])
  @@index([obligationId])
  @@index([decision])
  @@map("reconciliation_matches")
}

// ----------------------------------------------------------------------------
// PaymentNotice — Fase 3.2 (ver FASE_3_1_PREPARACION_DE_DATOS.md §7 y la
// tabla de decisiones de RECONCILIATION_MATCHING_ARCHITECTURE.md). Modela un
// comprobante/aviso de pago recibido (a futuro, por WhatsApp) — es
// estrictamente "alguien afirma haber pagado", NUNCA "el banco confirmó el
// pago". La única fuente de verdad de que el dinero se movió sigue siendo
// PaymentTransaction, sin cambios.
//
// Este modelo es únicamente infraestructura de datos en esta fase: no hay
// ningún código que lo cree, lo lea, ni lo correlacione todavía (no hay
// webhook de WhatsApp, no hay procesamiento automático, no hay matching). Un
// PaymentNotice NUNCA se convierte automáticamente en un PaymentTransaction
// — esa dirección de conversión está prohibida por diseño, no solo por
// buena práctica.
model PaymentNotice {
  id             String        @id @default(cuid())
  organizationId String? // nullable — puede no saberse todavía a qué organización pertenece (teléfono ambiguo entre organizaciones)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  phone      String // número de origen del mensaje, normalizado
  receivedAt DateTime @default(now())

  amount      Decimal?  @db.Decimal(14, 2) // lo que el remitente afirma haber pagado — NO confirmado
  claimedDate DateTime? // fecha que el remitente afirma (texto o comprobante)
  reference   String? // número de comprobante que menciona, si lo hay

  attachmentUrl String? // dónde vive el archivo adjunto (imagen/PDF) — mecanismo de storage fuera de alcance de esta fase
  extractedText String? // texto crudo extraído del mensaje/adjunto
  extractedData Json? // salida estructurada de la extracción — mismo criterio que PaymentTransaction.rawPayload

  status PaymentNoticeStatus @default(RECEIVED)

  linkedPaymentTransactionId String?
  linkedPaymentTransaction   PaymentTransaction? @relation(fields: [linkedPaymentTransactionId], references: [id], onDelete: SetNull)
  linkedUnitId               String?
  linkedUnit                 Unit?               @relation(fields: [linkedUnitId], references: [id], onDelete: SetNull)
  linkedUnitOwnerId          String?
  linkedUnitOwner            UnitOwner?          @relation(fields: [linkedUnitOwnerId], references: [id], onDelete: SetNull)

  confidence Int? // 0-99, mismo rango que ReconciliationMatch.score — null hasta que se calcule (fase futura)

  paymentEvidenceCorrelations PaymentEvidenceCorrelation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([phone])
  @@index([status])
  @@index([linkedPaymentTransactionId])
  @@map("payment_notices")
}

// Canonical, channel-agnostic receipt of external payment evidence. This is
// neither a payment claim (PaymentNotice), an assessment, nor a correlation.
// Original provenance is append-only: there is intentionally no updatedAt and
// this phase exposes create/read only. Binary/raw/OCR content never lives here.
model PaymentEvidenceIntake {
  id                     String                         @id @default(cuid())
  organizationId         String
  organization           Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  source                 PaymentEvidenceIntakeSource
  evidenceType           PaymentEvidenceIntakeType
  state                  PaymentEvidenceIntakeState     @default(RECEIVED)
  externalReference      String?
  storageReference       String?
  declaredMimeType       String?
  receivedAt             DateTime
  receivedBy             String?
  receivingAdministrator Administrator?                 @relation(fields: [receivedBy], references: [id], onDelete: Restrict)
  createdAt              DateTime                       @default(now())
  extractionRuns         PaymentEvidenceExtractionRun[]

  @@unique([organizationId, source, externalReference])
  @@index([organizationId, state, receivedAt])
  @@index([receivedBy])
  @@map("payment_evidence_intakes")
}

// One immutable attempt to extract facts from an intake. A failed or
// unsupported run never changes or invalidates the original intake.
model PaymentEvidenceExtractionRun {
  id               String                          @id @default(cuid())
  organizationId   String
  organization     Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  intakeId         String
  intake           PaymentEvidenceIntake           @relation(fields: [intakeId], references: [id], onDelete: Restrict)
  source           PaymentEvidenceExtractionSource
  extractor        String
  extractorVersion String
  status           PaymentEvidenceExtractionStatus
  errorCode        String?
  extractedAt      DateTime
  createdBy        String
  administrator    Administrator                   @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt        DateTime                        @default(now())
  facts            PaymentEvidenceFact[]
  correlations     PaymentEvidenceCorrelation[]

  @@index([organizationId, intakeId, extractedAt])
  @@index([intakeId, status])
  @@index([createdBy])
  @@map("payment_evidence_extraction_runs")
}

// Normalized observations only. Raw fragments and complete sensitive account
// identifiers are deliberately absent from durable storage.
model PaymentEvidenceFact {
  id                    String                       @id @default(cuid())
  organizationId        String
  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  extractionRunId       String
  extractionRun         PaymentEvidenceExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)
  type                  PaymentEvidenceFactType
  normalizedValue       String?
  numericValue          Decimal?                     @db.Decimal(14, 2)
  dateValue             DateTime?
  currency              String?
  dateRole              PaymentEvidenceDateRole?
  accountType           PaymentEvidenceAccountType?
  normalizedFingerprint String?
  maskedValue           String?
  confidence            Float?
  createdAt             DateTime                     @default(now())

  @@index([organizationId, type])
  @@index([extractionRunId])
  @@index([organizationId, normalizedFingerprint])
  @@map("payment_evidence_facts")
}

// Tenant mapping for inbound WhatsApp business channels. Provider secrets and
// sender/customer phone numbers deliberately do not belong in this table.
model WhatsAppChannelConnection {
  id                       String                          @id @default(cuid())
  organizationId           String
  organization             Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  provider                 WhatsAppProvider
  externalChannelReference String
  status                   WhatsAppChannelConnectionStatus @default(ACTIVE)
  createdBy                String
  administrator            Administrator                   @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt

  @@unique([provider, externalChannelReference])
  @@index([organizationId, status])
  @@index([createdBy])
  @@map("whatsapp_channel_connections")
}

// Persistent, tenant-scoped conversational container. Capabilities execute
// through an allowlisted service boundary; this model stores presentation
// text only, never model/tool payloads or arbitrary JSON.
model AgentConversation {
  id              String                  @id @default(cuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  administratorId String
  administrator   Administrator           @relation(fields: [administratorId], references: [id], onDelete: Restrict)
  title           String?
  status          AgentConversationStatus @default(ACTIVE)
  messages        AgentMessage[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([id, organizationId])
  @@index([administratorId, organizationId, status, updatedAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String
  organizationId String
  conversation   AgentConversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role           AgentMessageRole
  content        String
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@map("agent_messages")
}

// ----------------------------------------------------------------------------
// ShadowMatchLog — Fase 3.5 (ver FASE_3_4_IMPLEMENTATION_PLAN.md §2 para la
// decisión Opción B, y FASE_3_1.../RECONCILIATION_MATCHING_ARCHITECTURE.md
// para el diseño del motor). Persistencia durable del resultado del motor de
// matching en MODO SOMBRA — reemplaza al InMemoryShadowResultStore de la
// Fase 3.4, que no sobrevivía entre invocaciones serverless.
//
// Deliberadamente SEPARADO de ReconciliationMatch, que es append-only por
// diseño (cada fila = un evento de decisión real, nunca se actualiza). Este
// modelo necesita exactamente lo opuesto: upsert idempotente por
// (paymentTransactionId, engineVersion) — reevaluar la MISMA versión de
// motor sobre el mismo pago actualiza la fila existente, nunca duplica. Una
// engineVersion DISTINTA sí genera una fila independiente, a propósito, para
// poder comparar cómo cambió el resultado al recalibrar pesos/reglas/
// thresholds (ver §11 de RECONCILIATION_MATCHING_ARCHITECTURE.md).
//
// Es puramente OBSERVACIÓN: ninguna fila de esta tabla participa de una
// conciliación real. No la lee/escribe ni reconcile-payment.ts ni
// smart-match.ts, y no existe ningún camino de código que la use para crear
// un ReconciliationMatch, ni para modificar Obligation/Unit/UnitOwner.
model ShadowMatchLog {
  id                   String             @id @default(cuid())
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  // Qué versión del motor (src/lib/reconciliation/version.ts::MATCH_ENGINE_VERSION)
  // produjo este resultado — junto con paymentTransactionId, identifica una
  // evaluación única a los fines de idempotencia (ver @@unique abajo).
  engineVersion String

  // Candidato ganador — igual que ReconciliationMatch, todos nullable porque
  // un resultado BLOCKED/AMBIGUOUS puede no tener ningún candidato ganador.
  candidateUnitId String?
  candidateUnit   Unit?   @relation(fields: [candidateUnitId], references: [id], onDelete: SetNull)

  candidateUnitOwnerId String?
  candidateUnitOwner   UnitOwner? @relation(fields: [candidateUnitOwnerId], references: [id], onDelete: SetNull)

  candidateObligationId String?
  candidateObligation   Obligation? @relation(fields: [candidateObligationId], references: [id], onDelete: SetNull)

  score  Int // 0-99, mismo rango que ReconciliationMatch.score
  tier   Int? // tier más fuerte alcanzado entre las señales que matchearon — null si ninguna
  status ShadowMatchStatus

  // Fase 3.9 — PROPUESTO, migración NO ejecutada todavía (ver
  // FASE_3_9_..._REPORT.md — pendiente de tu aprobación explícita antes de
  // correr `prisma migrate dev`). Puramente diagnóstico: el score/tier del
  // MEJOR candidato encontrado, sin importar si `status` terminó siendo
  // BLOCKED/AMBIGUOUS — nunca participa de ninguna decisión, nunca habilita
  // AUTO. `null` = no hubo ningún candidato para evaluar (distinto de `0`,
  // que significa "hubo candidatos, el mejor puntuó cero"). Ver
  // src/lib/reconciliation/types.ts::ShadowMatchResult para el detalle
  // completo del contrato.
  topCandidateScore Int?
  topCandidateTier  Int?

  // Fase 5.1 — generaliza topCandidateScore/topCandidateTier (arriba) a
  // hasta 3 candidatos, para poder mostrar identidad real en un AMBIGUOUS
  // ("UF 1A — score 72, UF 2B — score 69") sin inventar nada: cada entrada
  // usa únicamente datos que deterministic-matcher.ts ya calcula
  // (CandidateEntry.unitCode/score/tier/signals) y match-engine.ts ya tenía
  // en memoria — solo se agrega la persistencia, cero cambio de cálculo.
  // NUNCA incluye ownerFullName (dato de persona, no pedido, se agrega
  // después si hace falta con esa decisión tomada explícitamente). `null` =
  // no hubo ningún candidato (mismo criterio que topCandidateScore=null).
  // Estructura: { unitCode: string, score: number, tier: number|null,
  // matchedSignals: string[] }[], ordenado desc por score.
  topCandidates Json?

  signals     Json // Signal[] estructurado — señal, tier, matched, strength, evidence
  blockers    Json // Blocker[] estructurado — nunca vacío en BLOCKED
  explanation String // texto legible, construido directamente desde signals/blockers — nunca reconstruido acá

  evaluatedAt DateTime // cuándo se calculó el resultado — puede diferir de createdAt/updatedAt de la fila
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt // se actualiza en cada upsert por la misma (paymentTransactionId, engineVersion)

  @@unique([paymentTransactionId, engineVersion])
  @@index([paymentTransactionId])
  @@index([status])
  @@index([engineVersion])
  @@map("shadow_match_logs")
}

// Fase 5.9 — persistencia diagnóstica de evidence-score.ts (Fase 5.7,
// lógica sin cambios). Tabla NUEVA, deliberadamente NO reutiliza
// ShadowMatchLog: responde una pregunta distinta (convergencia de familias
// de evidencia — WHATSAPP_MESSAGE/BANK_MOVEMENT/HISTORY — no solo el
// resultado del motor bancario), ver FASE_5_9_IMPLEMENTACION_FINAL.md para
// la justificación completa de por qué ShadowMatchLog resultó insuficiente.
// Mismo criterio de seguridad que ShadowMatchLog: puramente OBSERVACIÓN,
// nunca escrita por ningún camino que cree ReconciliationMatch ni modifique
// PaymentTransaction/Obligation/Unit/UnitOwner — reconciliation_matches
// sigue siendo la única fuente de verdad de una decisión real.
//
// Fase 5.9.1 — HISTORIAL INMUTABLE, no "una evaluación vigente" (corrige el
// hallazgo de FASE_5_9_1_AUDITORIA_SEMANTICA.md: el @@unique original hacía
// upsert = last-write-wins, perdiendo evaluaciones anteriores). La identidad
// de cada fila es su propio `id` — `paymentTransactionId`+`engineVersion`
// dejan de ser una clave de deduplicación y pasan a ser atributos
// descriptivos para AGRUPAR/FILTRAR el historial, nunca para sobrescribirlo.
// Cada llamada a guardar() SIEMPRE inserta una fila nueva — nunca UPDATE,
// nunca DELETE (mismo principio append-only que ya usaba ReconciliationMatch
// desde Fase 3.x). Reevaluar el mismo pago con la misma versión produce dos
// eventos históricos distintos, ambos conservados.
model PaymentEvidenceAssessmentLog {
  id                   String             @id @default(cuid())
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  // Qué versión de evidence-score.ts (src/lib/payment-evidence/version.ts::
  // EVIDENCE_SCORE_VERSION) produjo este resultado — atributo descriptivo
  // del evento, NO parte de ninguna clave única (Fase 5.9.1 — ver comentario
  // del modelo). Permite comparar cómo cambió la evaluación al recalibrar
  // evidence-score.ts sin perder el historial de ninguna versión.
  engineVersion String

  state PaymentEvidenceState

  // Denormalizado desde `families` (abajo) — la unidad candidata principal
  // (BANK_MOVEMENT si está presente, si no WHATSAPP_MESSAGE), únicamente
  // para poder comparar directo contra ReconciliationMatch.unitId sin tener
  // que parsear el Json. Nunca se usa para decidir nada — mismo criterio de
  // "puramente diagnóstico" que candidateUnitId en ShadowMatchLog.
  candidateUnitId String?
  candidateUnit   Unit?   @relation(fields: [candidateUnitId], references: [id], onDelete: SetNull)

  // EvidenceFamilyResult[] completo — WHATSAPP_MESSAGE/BANK_MOVEMENT/HISTORY,
  // siempre las 3, incluidas las MISSING. Ver evidence-score.ts para el
  // contrato exacto — nunca reconstruido acá, se persiste tal cual se
  // calculó.
  families Json

  // EvidenceFamilyName[] — familias con nature=POSITIVE que convergieron en
  // la misma unidad. Vacío no es un error: la mayoría de los resultados
  // reales (bank-only, sin WhatsApp todavía) tienen como mucho 1 familia.
  independentFamiliesConverging Json

  hasContradiction    Boolean
  contradictionDetail String?
  explanation         String

  // Fase 5.9.1 — snapshot ESTRUCTURADO (Signal[]/Blocker[]/topCandidates),
  // capturado en el momento exacto de ESTA evaluación puntual, directamente
  // desde el ShadowMatchResult ya calculado por runMatchingInShadow (sin
  // volver a leerlo de ShadowMatchLog, ni antes ni después). Cierra la
  // dependencia de auditoría hacia ShadowMatchLog identificada en
  // FASE_5_9_1_AUDITORIA_SEMANTICA.md §4: si ShadowMatchLog se archivara o
  // cambiara de esquema en el futuro, esta fila sigue siendo auditable por
  // sí sola. Forma: { bank: {signals, blockers, topCandidates} | null,
  // whatsapp: {signals, blockers} | null } — ver
  // evidence-score-store.ts::StructuredEvidenceSnapshot. Deliberadamente NO
  // incluye candidateUnitOwnerId/candidateObligationId del motor (esos
  // siguen siendo dominio exclusivo de ShadowMatchLog/ReconciliationMatch —
  // no son necesarios para explicar el ESTADO de evidence-score, y
  // duplicarlos sería exactamente el "duplicado indiscriminado" que se pidió
  // evitar).
  //
  // Nullable a propósito: la migración de Fase 5.9.1 encontró 1 fila real
  // preexistente (de la demo de Fase 5.9, antes de que este campo
  // existiera) — no hay ningún dato real de ese momento para completar acá,
  // y forzar un valor por defecto habría significado inventar evidencia que
  // nunca se capturó. `null` en filas viejas es honesto; todo evento nuevo
  // (desde esta fase en adelante) siempre lo completa.
  structuredEvidence Json?

  evaluatedAt DateTime
  createdAt   DateTime @default(now())
  // Fase 5.9.1 — `updatedAt` queda como columna vestigial: ninguna fila se
  // edita nunca después de creada (ver comentario del modelo), así que
  // siempre coincide con `createdAt`. Se conserva la columna en vez de
  // eliminarla para que esta migración sea estrictamente aditiva (ningún
  // DROP de columna con datos reales) — no aporta información nueva, no se
  // usa para nada.
  updatedAt   DateTime @updatedAt

  paymentEvidenceCorrelations PaymentEvidenceCorrelation[]

  @@index([paymentTransactionId, engineVersion])
  @@index([paymentTransactionId])
  @@index([state])
  @@index([candidateUnitId])
  @@map("payment_evidence_assessment_logs")
}

// Fase 5.0B — historial durable y append-only de candidatos y decisiones que
// correlacionan un aviso con un movimiento bancario real. Una fila no confirma
// por sí sola que el dinero se movió: PaymentTransaction conserva esa autoridad.
// linkedPaymentTransactionId en PaymentNotice es solamente la proyección de la
// única decisión CONFIRMED y se escribe atómicamente con ese evento.
model PaymentEvidenceCorrelation {
  id                   String                           @id @default(cuid())
  organizationId       String
  organization         Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentNoticeId      String?
  paymentNotice        PaymentNotice?                   @relation(fields: [paymentNoticeId], references: [id], onDelete: Cascade)
  extractionRunId      String?
  extractionRun        PaymentEvidenceExtractionRun?    @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)
  paymentTransactionId String
  paymentTransaction   PaymentTransaction               @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  status               PaymentEvidenceCorrelationStatus
  source               PaymentEvidenceCorrelationSource

  // Snapshot del score ya calculado por evidence-score; nunca se recalcula acá.
  confidence              Int?
  evidenceAssessmentLogId String?
  evidenceAssessmentLog   PaymentEvidenceAssessmentLog? @relation(fields: [evidenceAssessmentLogId], references: [id], onDelete: SetNull)
  reason                  String
  decidedBy               String?
  administrator           Administrator?                @relation(fields: [decidedBy], references: [id], onDelete: SetNull)
  createdAt               DateTime                      @default(now())
  payerUnitEvidenceEvents PayerUnitEvidenceEvent[]

  @@unique([paymentNoticeId, paymentTransactionId, status])
  @@unique([extractionRunId, paymentTransactionId, status])
  @@index([organizationId])
  @@index([paymentTransactionId])
  @@index([paymentNoticeId, status])
  @@index([evidenceAssessmentLogId])
  @@index([extractionRunId])
  @@index([decidedBy])
  @@map("payment_evidence_correlations")
}

// Fase 5.0C — un pagador operativo tenant-scoped. No implica ownership,
// occupancy ni responsabilidad legal, y no necesita apuntar a UnitOwner.
// La memoria N:M payer↔unit y sus eventos de aprendizaje pertenecen a 5.0D.
model Payer {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName      String?
  status           PayerStatus            @default(ACTIVE)
  source           PayerProvenanceSource
  reason           String
  createdBy        String?
  administrator    Administrator?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  identitySignals  PayerIdentitySignal[]
  unitAssociations PayerUnitAssociation[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([organizationId, status])
  @@index([createdBy])
  @@map("payers")
}

// Señal extensible de identidad. Nunca guarda el valor crudo: fingerprint es
// SHA-256 del valor normalizado y maskedValue sólo permite reconocimiento
// visual mínimo. payerId nullable representa identidad todavía no resuelta sin
// inventar un Payer "desconocido". No afirma una relación con ninguna unidad.
model PayerIdentitySignal {
  id                    String                  @id @default(cuid())
  organizationId        String
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payerId               String?
  payer                 Payer?                  @relation(fields: [payerId], references: [id], onDelete: SetNull)
  type                  PayerIdentitySignalType
  normalizedFingerprint String
  maskedValue           String
  source                PayerProvenanceSource
  reason                String
  createdBy             String?
  administrator         Administrator?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt             DateTime                @default(now())
  unitAssociations      PayerUnitAssociation[]

  @@unique([organizationId, type, normalizedFingerprint])
  @@index([organizationId, payerId])
  @@index([createdBy])
  @@map("payer_identity_signals")
}

// Fase 5.0D — proyección consultable de memoria histórica, nunca ownership,
// occupancy ni asignación automática. Exactamente uno de payerId/signalId se
// exige mediante CHECK en la migración; índices parciales preservan N:M.
model PayerUnitAssociation {
  id                 String                     @id @default(cuid())
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payerId            String?
  payer              Payer?                     @relation(fields: [payerId], references: [id], onDelete: Restrict)
  signalId           String?
  signal             PayerIdentitySignal?       @relation(fields: [signalId], references: [id], onDelete: Restrict)
  unitId             String
  unit               Unit                       @relation(fields: [unitId], references: [id], onDelete: Restrict)
  status             PayerUnitAssociationStatus @default(OBSERVED)
  observationCount   Int                        @default(0)
  supportCount       Int                        @default(0)
  contradictionCount Int                        @default(0)
  firstSeenAt        DateTime
  lastSeenAt         DateTime
  events             PayerUnitEvidenceEvent[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([organizationId, unitId, status])
  @@index([organizationId, payerId])
  @@index([organizationId, signalId])
  @@map("payer_unit_associations")
}

// Evento causal append-only. evidenceKey es un hash de la provenance lógica,
// no PII ni timestamp; impide que reintentos inflen la proyección.
model PayerUnitEvidenceEvent {
  id                           String                      @id @default(cuid())
  organizationId               String
  organization                 Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  associationId                String
  association                  PayerUnitAssociation        @relation(fields: [associationId], references: [id], onDelete: Restrict)
  effect                       PayerUnitEvidenceEffect
  source                       PayerUnitEvidenceSource
  evidenceKey                  String
  confidence                   Int?
  paymentEvidenceCorrelationId String?
  paymentEvidenceCorrelation   PaymentEvidenceCorrelation? @relation(fields: [paymentEvidenceCorrelationId], references: [id], onDelete: Restrict)
  reconciliationMatchId        String?
  reconciliationMatch          ReconciliationMatch?        @relation(fields: [reconciliationMatchId], references: [id], onDelete: Restrict)
  reason                       String
  observedAt                   DateTime
  createdBy                    String?
  administrator                Administrator?              @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt                    DateTime                    @default(now())

  @@unique([organizationId, evidenceKey])
  @@index([associationId, createdAt])
  @@index([organizationId, source])
  @@index([paymentEvidenceCorrelationId])
  @@index([reconciliationMatchId])
  @@index([createdBy])
  @@map("payer_unit_evidence_events")
}

// ============================================================================
// Compliance Foundation — Fase 4 Parte C (ver FASE_4_PLAN_COMPLIANCE_Y_AGENT_OS.md
// y el informe de esta fase para el detalle completo de las decisiones de
// diseño). Dominio 100% nuevo y aditivo — ninguna relación hacia
// PaymentTransaction/ReconciliationMatch/Obligation/UnitOwner, a propósito:
// el motor de conciliación no debe conocer ni depender de este dominio (ni
// viceversa). Solo se relaciona con Organization, vía FKs explícitas
// nullable — nunca un par entityType/entityId polimórfico (no existe ese
// patrón en ningún otro lado de este schema).
//
// Esta fase construye ÚNICAMENTE el dominio de datos: RegulatoryRequirement
// (catálogo de qué exige la normativa — LEGAL REQUIREMENT), Provider/
// ProviderOrganization (identidad del proveedor vs. su relación con cada
// consorcio) y ProviderDocument (el documento real presentado). NO incluye
// todavía ComplianceAlert, AgentAction ni AgentPolicy — esas dependen de
// este dominio y se construyen en una fase posterior, sobre esta base.
// ============================================================================

enum RegulatoryRequirementScope {
  ADMINISTRATOR
  PROVIDER
  ORGANIZATION
}

enum RegulatoryRequirementType {
  INSCRIPCION
  DOCUMENTACION_PROVEEDOR
  DDJJ_ANUAL
  CAPACITACION
  LIQUIDACION_EXPENSAS
  OTRO
}

// Catálogo VERSIONADO de obligaciones normativas reales (LEGAL REQUIREMENT,
// nunca "lo que ConcilIA decide controlar" — eso es una POLICY futura,
// deliberadamente fuera de este modelo). Nunca se hardcodea el contenido de
// una ley como lógica de código distribuida — vive acá, con fuente citada y
// `ultimaVerificacion` explícita, precisamente porque ya se demostró en esta
// misma fase que un plazo como el de la DDJJ anual de Ley 941 lo fija cada
// año una Disposición administrativa, no la ley — ningún campo de acá se
// asume vigente indefinidamente sin volver a chequearlo.
model RegulatoryRequirement {
  id String @id @default(cuid())

  titulo       String // qué requisito representa, corto y legible (ej. "Seguro ART de contratistas")
  jurisdiccion String // dominio geográfico/regulatorio — texto libre a propósito (ej. "CABA"); no se modela como enum cerrado para no tener que migrar el schema si se agrega otra jurisdicción
  norma        String // ej. "Ley 941"
  articulo     String? // ej. "Art. 11" — nullable: no toda fuente se cita a nivel de artículo puntual
  descripcion  String
  tipo         RegulatoryRequirementType
  alcance      RegulatoryRequirementScope

  // Texto libre, nunca un FK/enum estricto a ProviderDocumentType — un
  // requisito con alcance=ADMINISTRATOR/ORGANIZATION (ej. la DDJJ anual) no
  // corresponde a ningún tipo de documento de proveedor.
  documentacionEsperada String?

  vigenteDesde DateTime?
  vigenteHasta DateTime? // null = sigue vigente — "vigente" es SIEMPRE derivado (vigenteHasta==null || vigenteHasta>hoy), nunca un boolean persistido que alguien deba sincronizar a mano

  fuenteNombre String? // ej. "Boletín Oficial CABA", "JURISTECA"
  fuenteUrl    String
  fuenteTexto  String? // cita textual opcional

  // OBLIGATORIO, nunca implícito — cuándo se confirmó esto contra la fuente
  // real la última vez. Distinto de updatedAt (que solo dice "la fila
  // cambió", no "alguien re-verificó que el dato siga siendo correcto").
  ultimaVerificacion DateTime

  // Versionado — nunca se sobreescribe una versión existente. Si la
  // interpretación/vigencia de un requisito cambia, se crea una fila nueva
  // que reemplaza a la anterior (mismo criterio append-preferido ya usado
  // en el resto del proyecto para no perder historial).
  version      Int                    @default(1)
  supersedesId String?                @unique
  supersedes   RegulatoryRequirement? @relation("RequirementVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy RegulatoryRequirement? @relation("RequirementVersion")

  // Documentos reales que se presentaron intentando satisfacer este
  // requisito — relación EXPLÍCITA y OPCIONAL (ver ProviderDocument.requirementId):
  // no todo documento de proveedor corresponde a un requisito puntual.
  providerDocuments ProviderDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([alcance])
  @@index([tipo])
  @@index([jurisdiccion])
  @@map("regulatory_requirements")
}

// Identidad del proveedor — separada a propósito de su relación con cada
// consorcio (ver ProviderOrganization abajo): la misma empresa de
// ascensores puede trabajar para 5 consorcios distintos, y es UN solo
// Provider, no 5 filas duplicadas.
model Provider {
  id        String  @id @default(cuid())
  name      String
  taxId     String? // CUIT — nullable (puede cargarse el proveedor antes de tener el dato), único cuando está presente
  matricula String?

  organizations           ProviderOrganization[]
  documents               ProviderDocument[]
  administrativeDocuments AdministrativeDocument[]
  // Fase 4 Parte D — relación inversa obligatoria de Prisma (sintaxis, cero
  // columna real nueva acá). Ver AgentObservation más abajo.
  agentObservations       AgentObservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — mismo criterio que el resto del schema

  @@unique([taxId])
  @@map("providers")
}

enum AdministrativeDocumentType {
  INVOICE
  CONTRACT
  RECEIPT
  STATEMENT
  OTHER
}

enum AdministrativeDocumentStatus {
  ACTIVE
  ARCHIVED
}

// Metadata tenant-scoped para documentación administrativa general. El
// archivo es opcional y se referencia mediante un identificador opaco; nunca
// se persisten URLs públicas ni se sobrecarga PaymentEvidenceIntake.
model AdministrativeDocument {
  id                       String                       @id @default(cuid())
  organizationId           String
  providerId               String?
  createdByAdministratorId String?
  type                     AdministrativeDocumentType
  status                   AdministrativeDocumentStatus @default(ACTIVE)
  title                    String
  period                   DateTime?
  issuedAt                 DateTime?
  expiresAt                DateTime?
  amount                   Decimal?                     @db.Decimal(14, 2)
  currency                 String?
  storageReference         String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  deletedAt                DateTime?

  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  provider               Provider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  createdByAdministrator Administrator? @relation(fields: [createdByAdministratorId], references: [id], onDelete: SetNull)

  @@index([organizationId, type, period])
  @@index([organizationId, expiresAt])
  @@index([organizationId, providerId])
  @@map("administrative_documents")
}

// La relación N:M explícita Provider↔Organization — un proveedor puede
// trabajar para múltiples consorcios sin duplicar su identidad (mismo
// patrón ya usado por OrganizationAdministrator/ContactOrganization en este
// schema, nunca un array implícito).
model ProviderOrganization {
  id             String   @id @default(cuid())
  providerId     String
  organizationId String
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  provider     Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([providerId, organizationId])
  @@index([organizationId])
  @@map("provider_organizations")
}

enum ProviderDocumentType {
  ART
  RC
  MATRICULA
  AFIP
  ANSES
  OTRO
}

// Ciclo de vida ADMINISTRATIVO del documento en sí — NO es "vigente/
// vencido" (eso se deriva de `validTo` en consulta, ver
// src/lib/compliance/document-status.ts — nunca un estado persistido que
// alguien deba mantener sincronizado con el reloj).
enum ProviderDocumentStatus {
  PENDING_REVIEW
  ACTIVE
  SUPERSEDED
  REJECTED
}

// El documento REAL presentado por un proveedor — no un requisito
// abstracto (eso es RegulatoryRequirement). Genérico a propósito: un solo
// modelo cubre ART, RC, matrículas, habilitaciones, AFIP/ANSES o
// cualquier otro tipo futuro vía el enum `type` + `validTo` — nunca campos
// específicos como `artVencimiento`/`seguroVencimiento`.
model ProviderDocument {
  id             String  @id @default(cuid())
  providerId     String
  // null = documentación reutilizable para TODAS las organizaciones que
  // contratan a este proveedor (vía ProviderOrganization); con valor =
  // específica de una sola (ej. una póliza endosada a un consorcio puntual,
  // Ley 941 Art. 11). No se fuerza a nivel de constraint de base que ese
  // valor coincida con una ProviderOrganization activa — simplificación
  // deliberada de esta fase (ver informe, "riesgos"), validable a nivel de
  // aplicación cuando exista un CRUD real.
  organizationId String?
  // null = documento propio del proveedor / política interna del
  // administrador, no atado a un requisito normativo puntual — nunca se
  // asume que TODO documento de proveedor es, por sí solo, un requisito
  // legal.
  requirementId  String?

  type   ProviderDocumentType
  status ProviderDocumentStatus @default(PENDING_REVIEW)

  documentNumber String?
  issuedAt       DateTime? // fecha de emisión
  validTo        DateTime? // fecha de vencimiento — null = sin vencimiento (ej. una matrícula que no vence)

  evidenceUrl String? // dónde vive el archivo — mecanismo de storage fuera de alcance de esta fase (mismo gap ya documentado, sin resolver, en PaymentNotice.attachmentUrl desde Fase 3.2)

  // Trazabilidad de origen del dato — separada de `status` a propósito:
  // "la IA lo extrajo de un documento" nunca implica, por sí solo,
  // "está verificado". Un futuro agente de extracción puede poblar
  // extractedByAI=true sin que eso cambie `verifiedByHuman`.
  extractedByAI   Boolean @default(false)
  verifiedByHuman Boolean @default(false)
  uploadedBy      String? // quién lo cargó

  // Una renovación crea una fila NUEVA — nunca se edita `validTo` in-place
  // sobre el documento anterior (mismo criterio append-preferido que el
  // resto del proyecto). `@unique` porque cada documento anterior tiene, a
  // lo sumo, UNA renovación directa (cadena, no árbol).
  previousDocumentId String?           @unique
  previousDocument   ProviderDocument? @relation("DocumentRenewal", fields: [previousDocumentId], references: [id], onDelete: SetNull)
  renewal            ProviderDocument? @relation("DocumentRenewal")

  provider     Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  requirement  RegulatoryRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  // Fase 4 Parte D — relación inversa obligatoria (sintaxis, cero columna real).
  agentObservations AgentObservation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([providerId])
  @@index([organizationId])
  @@index([type])
  @@index([validTo])
  @@index([requirementId])
  @@map("provider_documents")
}

// ============================================================================
// Agent OS — Fase 4 Parte D (ver FASE_4_PARTE_D_PLAN.md). Abstracción mínima
// y reusable: de las 7 entidades conceptuales evaluadas (Agent/AgentRun/
// AgentObservation/AgentProposal/AgentPolicy/AgentAction/AgentAudit), esta
// fase construye ÚNICAMENTE AgentObservation — el resto se descartó
// explícitamente por no tener todavía nada real que gobernar (sin acciones,
// sin ejecución programada, sin múltiples agentes reales compitiendo por
// identidad). Ver el plan para la justificación completa de cada una.
//
// Generaliza (no duplica) el diseño de "ComplianceAlert" esbozado en
// FASE_4_PLAN_COMPLIANCE_Y_AGENT_OS.md antes de Fase 4 Parte C — es el
// MISMO concepto, renombrado para servir a cualquier agente futuro
// (Matching, Expensas, Vencimientos...), no solo Compliance.
//
// Fase 4.F — primer agente adicional real: MATCHING (ver
// src/lib/reconciliation/matching-observer.ts). Sumó `paymentTransactionId`
// (FK explícita nullable, mismo criterio que providerId/providerDocumentId)
// para poder referenciar el pago que originó la observación — la única
// relación nueva de esta tabla hacia el dominio de conciliación. Sigue sin
// relacionarse con Obligation/UnitOwner/ReconciliationMatch.
//
// Es puramente OBSERVACIÓN — ningún campo ni relación de acá ejecuta nada.
// FKs explícitas nullable, nunca entityType/entityId polimórfico (mismo
// patrón ya exigido en todo Compliance Foundation).
// ============================================================================

enum AgentType {
  COMPLIANCE
  MATCHING // Fase 4.F — Motor de Matching en modo sombra (ver matching-observer.ts)
}

enum AgentObservationType {
  DOCUMENT_EXPIRED
  DOCUMENT_EXPIRING_SOON
  PROVIDER_WITHOUT_DOCUMENTS
  // Deliberadamente NO incluye "documentación faltante según lo que exige
  // la normativa" — requeriría RegulatoryRequirement sembrado con contenido
  // legal verificado (0 filas hoy) — ver FASE_4_PARTE_D_PLAN.md §4.

  // Fase 4.F — origen Motor de Matching (ver matching-observer.ts).
  // Deliberadamente NO incluye un tipo para CANDIDATE: un match limpio no es
  // un problema que requiera atención — se reporta agregado en el resumen
  // ejecutivo del panel, nunca como una fila de AgentObservation (evita
  // confundir 🟢 "resuelto" con "nunca fue un problema").
  PAYMENT_MATCH_BLOCKED
  PAYMENT_MATCH_AMBIGUOUS
}

enum AgentObservationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AgentObservationStatus {
  OPEN
  RESOLVED // re-computado en cada corrida del detector, ver compliance-detector.ts
}

model AgentObservation {
  id String @id @default(cuid())

  agentType AgentType
  type      AgentObservationType
  severity  AgentObservationSeverity
  status    AgentObservationStatus   @default(OPEN)

  providerId           String?
  providerDocumentId   String?
  organizationId       String?
  // Fase 4.F — FK explícita nullable hacia el pago que originó la
  // observación (agentType=MATCHING). Mismo criterio que providerId/
  // providerDocumentId: nunca entityType/entityId polimórfico. Null para
  // observaciones de Compliance (agentType=COMPLIANCE), que no se originan
  // en un pago.
  paymentTransactionId String?

  provider           Provider?           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerDocument   ProviderDocument?   @relation(fields: [providerDocumentId], references: [id], onDelete: Cascade)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  explanation     String // por qué existe esta observación, legible por un humano
  evidence        Json // datos estructurados reales que la sustentan — nunca inventados
  suggestedAction String? // "propuesta de siguiente paso" — texto, NO una acción ejecutable
  source          String // qué regla determinística la generó (ej. "compliance:document-expiry")
  confidence      Int? // reservado para observaciones futuras asistidas por IA — null en toda detección determinística

  // Idempotencia — string calculado en código (no una unique compuesta con
  // columnas nullable: Postgres no deduplica NULLs entre sí, rompería la
  // idempotencia de observaciones a nivel-proveedor sin documento puntual).
  dedupeKey String @unique

  detectedAt DateTime // cuándo se detectó por primera vez esta condición
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt // se actualiza en cada re-detección (upsert por dedupeKey)

  @@index([agentType])
  @@index([type])
  @@index([status])
  @@index([providerId])
  @@index([organizationId])
  @@index([paymentTransactionId])
  @@map("agent_observations")
}
